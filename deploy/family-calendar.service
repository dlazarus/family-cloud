[Unit]
Description=Calendario familiar
After=network.target

[Service]
Type=simple
User=familycal
Group=familycal
WorkingDirectory=/srv/family-calendar
ExecStart=/usr/bin/node /srv/family-calendar/src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/family-calendar/data

[Install]
WantedBy=multi-user.target
