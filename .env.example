# Family Cloud — copiar a .env y rellenar (chmod 600). Nunca subir el .env real al repositorio.
# Generar valores con: node scripts/gen-env.js

# Frase maestra para cifrar los datos sensibles (eventos, contraseñas, nombres de archivo).
# ¡IMPORTANTE! Si se pierde, los datos existentes no se pueden descifrar.
MASTER_PASSPHRASE=cambia-esta-frase-por-una-larga-y-secreta
MASTER_SALT=hex-aleatorio-de-32-bytes

# Secreto para firmar las cookies de sesión
SESSION_SECRET=hex-aleatorio-de-32-bytes

# ─── Dónde se guarda todo (acepta ruta relativa al proyecto o absoluta) ───
# DATA_DIR: la base de datos. Debe quedar en el disco de sistema del servidor:
#           SQLite en modo WAL necesita bloqueos POSIX fiables (NTFS/vfat/FUSE no los dan).
DATA_DIR=./data
# FILES_DIR: los archivos de los usuarios, cifrados. Aquí SÍ puede ir un disco externo
#            dedicado para no llenar el del servidor. Preparar el disco (particionar,
#            formatear, montar y dar espacio) es responsabilidad del sysadmin: el
#            instalador solo usa la ruta que se le indique, no monta ni formatea nada.
#            Ejemplo: FILES_DIR=/mnt/datos/family-cloud-files
FILES_DIR=./data/files

# ─── Límites de la tarjeta «Archivos» ───
# Cupo por defecto por cuenta (MB). 0 = sin límite. El admin lo puede cambiar
# globalmente y conceder cupos especiales por usuario desde la web.
FILE_QUOTA_MB=4096
# Tope por archivo (MB). 0 = sin tope por archivo: solo manda el cupo de la cuenta.
FILE_MAX_UPLOAD_MB=0
# Margen mínimo de espacio libre que debe quedar en FILES_DIR (MB).
FILE_MIN_FREE_MB=2048

# Escucha (HTTP en la LAN)
HOST=0.0.0.0
PORT=3000
